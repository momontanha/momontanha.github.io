---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
const pagina = (await getEntry('paginas', 'sobre'))!;
const { Content } = await render(pagina);
const { foto, foto_legenda } = pagina.data;
---
<Base titulo="Sobre" descricao="Quem escreve o Momontanha.">
  <div class="prosa">
    <h1>Sobre</h1>
    <Content />
    {foto && (
      <figure class="foto-perfil">
        <Image src={foto} alt={foto_legenda ?? 'Foto do autor'} width={640} />
        {foto_legenda && <figcaption>{foto_legenda}</figcaption>}
      </figure>
    )}
  </div>
</Base>

<style>
  .foto-perfil { margin: 2rem auto 0; max-width: 18rem; text-align: center; }
  .foto-perfil :global(img) { width: 100%; height: auto; border-radius: 12px; margin: 0; }
  .foto-perfil figcaption { margin-top: 0.6rem; font-weight: 700; color: var(--titulo); }
</style>
