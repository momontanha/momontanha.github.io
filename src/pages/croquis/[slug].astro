---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import FotoLinhas from '../../components/FotoLinhas.astro';
import { url, dataBR, faixaGrau, CORES_FAIXA } from '../../lib/util';

export async function getStaticPaths() {
  const croquis = await getCollection('croquis');
  return croquis.map((croqui) => ({ params: { slug: croqui.id }, props: { croqui } }));
}
const { croqui } = Astro.props;
const { Content } = await render(croqui);
const d = croqui.data;

// Numeração contínua das linhas no croqui inteiro (se não vier no arquivo).
let contador = 0;
const subsetores = d.subsetores.map((s) => ({
  ...s,
  blocos: s.blocos.map((b) => ({ ...b, linhas: b.linhas.map((l) => ({ ...l, n: l.n ?? ++contador })) })),
}));
const todas = subsetores.flatMap((s) => s.blocos.flatMap((b) => b.linhas));
const totalBlocos = subsetores.reduce((n, s) => n + s.blocos.length, 0);
const pdf = url(`/pdf/${croqui.id}-v${d.versao}${d.rascunho ? '-rascunho' : ''}.pdf`);
const mapa = d.coordenadas ? `https://www.google.com/maps/search/?api=1&query=${d.coordenadas[0]},${d.coordenadas[1]}` : undefined;
const og = d.capa ? (await getImage({ src: d.capa, width: 1200 })).src : undefined;
const faixas = [
  ['facil', 'V0–V2'], ['medio', 'V3–V5'], ['dificil', 'V6–V8'], ['muito-dificil', 'V9+'], ['projeto', 'projeto'],
] as const;
const descricao = `Croqui de ${d.tipo} ${d.setor} — ${d.regiao}, ${d.municipio}. ${todas.length} linhas em ${totalBlocos} blocos. Versão ${d.versao}, web e PDF.`;
---
<Base titulo={d.titulo} descricao={descricao} imagem={og} noindex={d.rascunho} classe="pagina-croqui">
  {d.rascunho && <p class="aviso faixa-rascunho">Rascunho — esta versão ainda não foi publicada na croquiteca.</p>}
  <header class="cabeca-croqui">
    <p class="meta"><a href={url('/croquiteca/')}>Croquiteca</a> · {d.regiao}</p>
    <h1>{d.titulo}</h1>
    <p class="selo">Versão {d.versao} · atualizado em {dataBR(d.atualizado)} · croqui pessoal, não oficial</p>
    <ul class="botoes nao-imprimir">
      <li><a class="botao" href={pdf} download>Baixar PDF<small>versão {d.versao}</small></a></li>
      {mapa && <li><a class="botao secundario" href={mapa}>Ver no mapa<small>{d.coordenadas!.join(', ')}</small></a></li>}
    </ul>
  </header>

  {d.capa && (
    <figure class="capa-croqui">
      <Image src={d.capa} alt={`${d.setor}`} width={1600} loading="eager" />
      {d.capa_credito && <figcaption>{d.capa_credito}</figcaption>}
    </figure>
  )}

  <dl class="ficha">
    <div><dt>Local</dt><dd>{d.municipio}</dd></div>
    <div><dt>Estilo</dt><dd>{d.tipo}</dd></div>
    <div><dt>Linhas</dt><dd>{todas.length} em {totalBlocos} blocos</dd></div>
    <div><dt>Escala</dt><dd>{d.escala}</dd></div>
    {d.coordenadas && <div><dt>Coordenadas</dt><dd class="coord">{d.coordenadas.join(', ')}</dd></div>}
  </dl>

  <div class="prosa texto-croqui"><Content /></div>

  <section class="legenda">
    <h2>Legenda</h2>
    <ul>
      {faixas.map(([f, rot]) => <li><span class="traco" style={`--cor:${CORES_FAIXA[f]}`} data-projeto={f === 'projeto' ? '' : undefined}></span>{rot}</li>)}
    </ul>
    <p class="pequeno">O número fica no início da linha. SDS = saída sentado. Graus sugeridos: confirme na rocha.</p>
  </section>

  {subsetores.map((s) => (
    <section class="subsetor">
      <h2>{s.nome}</h2>
      {s.descricao && <p>{s.descricao}</p>}
      {s.blocos.map((b) => (
        <article class="bloco">
          <h3>{b.nome}</h3>
          {b.descricao && <p>{b.descricao}</p>}
          {b.foto && <FotoLinhas foto={b.foto} alt={`Bloco ${b.nome}`} linhas={b.linhas} credito={b.foto_credito} />}
          <table>
            <thead><tr><th>Nº</th><th>Linha</th><th>Grau</th><th>Conquista</th></tr></thead>
            <tbody>
              {b.linhas.map((l) => (
                <tr>
                  <td><span class="num" style={`--cor:${CORES_FAIXA[faixaGrau(l.grau)]}`}>{l.n}</span></td>
                  <td><strong>{l.nome}</strong>{l.saida === 'sentado' && ' (SDS)'}{l.descricao && <div class="pequeno">{l.descricao}</div>}</td>
                  <td>{l.grau}</td>
                  <td class="pequeno">{[l.conquista, l.ano].filter(Boolean).join(', ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </article>
      ))}
    </section>
  ))}

  <section class="creditos">
    <h2>Créditos e fontes</h2>
    <ul>{d.creditos.map((c) => <li>{c}</li>)}</ul>
    <h2>Histórico de versões</h2>
    <table>
      <thead><tr><th>Versão</th><th>Data</th><th>O que mudou</th></tr></thead>
      <tbody>{[...d.historico].reverse().map((h) => <tr><td>{h.versao}</td><td>{dataBR(h.data)}</td><td>{h.mudancas}</td></tr>)}</tbody>
    </table>
    <p class="pequeno">Viu algo errado ou abriu uma linha nova? Fale comigo para entrar na próxima versão.</p>
  </section>
</Base>

<style is:global>
  .pagina-croqui .selo { display: inline-block; background: var(--marca); color: var(--sobre-marca); padding: 0.2rem 0.7rem; border-radius: 99px; font-size: 0.9rem; }
  .pagina-croqui .capa-croqui { margin: 1rem 0; }
  .pagina-croqui .capa-croqui img { display: block; width: auto; max-width: 100%; max-height: 34rem; margin: 0 auto; border-radius: 10px; }
  .pagina-croqui figcaption { font-size: 0.8rem; color: var(--cinza); }
  .ficha { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.8rem; background: var(--superficie); border: 1px solid var(--linha); border-radius: 10px; padding: 1rem; }
  .ficha div { margin: 0; } .ficha dt { font-size: 0.75rem; text-transform: uppercase; color: var(--cinza); letter-spacing: 0.05em; } .ficha dd { margin: 0; font-weight: 600; }
  .ficha .coord { white-space: nowrap; }
  .texto-croqui { margin: 1.5rem 0; max-width: none; }
  .legenda ul { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; list-style: none; padding: 0; margin: 0.3rem 0; }
  .legenda li { display: flex; align-items: center; gap: 0.4rem; }
  .traco { display: inline-block; width: 2rem; height: 0; border-top: 4px solid var(--cor); }
  .traco[data-projeto] { border-top-style: dashed; }
  .traco { box-shadow: 0 0 0 1px var(--linha); }
  .subsetor { margin-top: 2.5rem; }
  .subsetor > h2 { background: var(--marca); color: var(--sobre-marca); padding: 0.4rem 0.8rem; border-radius: 6px; }
  .bloco { margin: 1.2rem 0 1.8rem; break-inside: avoid; }
  .bloco h3 { margin-bottom: 0.3rem; }
  .pagina-croqui table { width: 100%; border-collapse: collapse; background: var(--superficie); font-size: 0.95rem; table-layout: fixed; }
  .bloco th:nth-child(1) { width: 2.6rem; } .bloco th:nth-child(2) { width: 42%; } .bloco th:nth-child(3) { width: 4.5rem; }
  .creditos th:nth-child(1) { width: 4rem; } .creditos th:nth-child(2) { width: 9rem; }
  .pagina-croqui th, .pagina-croqui td { text-align: left; padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--linha); vertical-align: top; }
  .pagina-croqui th { font-size: 0.75rem; text-transform: uppercase; color: var(--cinza); letter-spacing: 0.04em; }
  .num { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--cor); color: #fff; font-weight: 700; font-size: 0.85rem; box-shadow: 0 0 0 1px var(--linha); }
  .creditos { margin-top: 2.5rem; }

  @page { size: A4; margin: 14mm 12mm 16mm; }
  @media print {
    :root { font-size: 10.5pt; background: #fff; }
    .topo-site, .rodape, .nao-imprimir, .faixa-rascunho { display: none !important; }
    main { padding: 0; }
    a { color: inherit; text-decoration: none; }
    .pagina-croqui .capa-croqui img { max-height: 120mm; }
    .subsetor { break-before: page; margin-top: 0; }
    .creditos { break-before: page; }
    .bloco, tr { break-inside: avoid; }
    .subsetor > h2, .num, .selo, .traco { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
