---
/**
 * Mapa de setor desenhado em SVG a partir de uma especificação em src/mapas/<id>.json:
 * blocos (contorno em pontos, suavizado), trilhas, áreas (clareira, pedreira), textos e saídas.
 * Blocos que estão no croqui (`ancora`) saem escuros e viram link para o bloco; os outros, claros.
 * Cores vêm de variáveis CSS, então o mapa acompanha o modo escuro (e sai claro no PDF).
 */
type P = [number, number];
interface Rotulo { texto: string; x?: number; y?: number; a?: 'start' | 'middle' | 'end'; dentro?: boolean; rot?: number; tam?: number; ancora?: P }
interface Spec {
  largura: number; altura: number;
  areas: { tipo: 'clareira' | 'pedreira'; pts: P[]; rotulo?: Rotulo }[];
  trilhas: { pts: P[]; tipo?: 'interditada'; rotulo?: Rotulo }[];
  blocos: { pts: P[]; ancora?: string; rotulo?: Rotulo }[];
  textos: (Rotulo & { estilo?: 'setor' | 'nota' | 'outro' | 'bloco'; link?: string })[];
  saidas: { de: P; para: P; texto: string; sub?: string; x: number; y: number; a?: 'start' | 'middle' | 'end' }[];
}
interface Props { id: string; titulo: string }
const { id, titulo } = Astro.props;
const specs = import.meta.glob<Spec>('../mapas/*.json', { eager: true, import: 'default' });
const m = specs[`../mapas/${id}.json`];
if (!m) throw new Error(`Mapa não encontrado: src/mapas/${id}.json`);
const W = m.largura, H = m.altura;
const uid = `m-${id}`;

/** Catmull-Rom → Bézier: caminho suave passando pelos pontos. */
function suave(pts: P[], fechado = false): string {
  const n = pts.length;
  const p = (i: number) => (fechado ? pts[(i + n) % n] : pts[Math.max(0, Math.min(n - 1, i))]);
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < (fechado ? n : n - 1); i++) {
    const [p0, p1, p2, p3] = [p(i - 1), p(i), p(i + 1), p(i + 2)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0]},${p2[1]}`;
  }
  return fechado ? d + 'Z' : d;
}
const centro = (pts: P[]): P => [pts.reduce((s, p) => s + p[0], 0) / pts.length, pts.reduce((s, p) => s + p[1], 0) / pts.length];
const linhas = (t: string) => t.split('\n');

// curvas de nível decorativas (determinísticas por mapa)
let semente = [...id].reduce((s, c) => (s * 31 + c.charCodeAt(0)) >>> 0, 7);
const rnd = () => ((semente = (semente * 1664525 + 1013904223) >>> 0) / 2 ** 32);
const curvas = Array.from({ length: 7 }, (_, k) => {
  const y0 = ((k + 0.5) * H) / 7 + (rnd() - 0.5) * 30;
  const fase = rnd() * 6, amp = 14 + rnd() * 22;
  const pts: P[] = [];
  for (let x = -40; x <= W + 40; x += 120) pts.push([x, Math.round(y0 + Math.sin(x / 170 + fase) * amp + (rnd() - 0.5) * 16)]);
  return suave(pts);
});

/** Seta da saída: haste de `de` até `para` e ponta em `para`. */
function seta(de: P, para: P) {
  const dx = para[0] - de[0], dy = para[1] - de[1], L = Math.hypot(dx, dy) || 1;
  const u = [dx / L, dy / L], v = [-u[1], u[0]];
  const tip: P = [para[0] + u[0] * 14, para[1] + u[1] * 14];
  const a: P = [para[0] - u[0] * 8 + v[0] * 14, para[1] - u[1] * 8 + v[1] * 14];
  const b: P = [para[0] - u[0] * 8 - v[0] * 14, para[1] - u[1] * 8 - v[1] * 14];
  return { haste: `M${de[0]},${de[1]} L${para[0]},${para[1]}`, ponta: `${tip.join(',')} ${a.join(',')} ${b.join(',')}` };
}
const blocosOrdenados = [...m.blocos].sort((a, b) => Number(!!a.ancora) - Number(!!b.ancora));
---
<svg class="mapa-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={titulo} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <filter id={`${uid}-sombra`} x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#000" flood-opacity="0.22" />
    </filter>
    <pattern id={`${uid}-hachura`} width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="12" height="12" class="m-pedreira" />
      <line x1="0" y1="0" x2="0" y2="12" class="m-hachura" />
    </pattern>
    <clipPath id={`${uid}-quadro`}><rect width={W} height={H} rx="22" /></clipPath>
  </defs>
  <g clip-path={`url(#${uid}-quadro)`}>
    <rect width={W} height={H} class="m-fundo" />
    {curvas.map((d) => <path d={d} class="m-curva" />)}

    {m.areas.map((a) => (
      <path d={suave(a.pts, true)} class={a.tipo === 'clareira' ? 'm-clareira' : 'm-area-pedreira'} fill={a.tipo === 'pedreira' ? `url(#${uid}-hachura)` : undefined} />
    ))}

    {m.trilhas.map((t) => <path d={suave(t.pts)} class="m-trilha-halo" />)}
    {m.trilhas.map((t) => <path d={suave(t.pts)} class={t.tipo === 'interditada' ? 'm-trilha m-interditada' : 'm-trilha'} />)}

    {m.saidas.map((s) => { const sp = seta(s.de, s.para); return (
      <g class="m-saida">
        <path d={sp.haste} class="m-saida-haste" />
        <polygon points={sp.ponta} class="m-saida-ponta" />
      </g>
    ); })}

    {blocosOrdenados.map((b) => {
      const forma = <path d={suave(b.pts, true)} class={b.ancora ? 'm-bloco' : 'm-bloco m-outro'} filter={`url(#${uid}-sombra)`} />;
      return b.ancora ? <a href={`#${b.ancora}`}>{forma}</a> : forma;
    })}

    {[...m.blocos, ...m.areas, ...m.trilhas].filter((b) => b.rotulo).map((b) => {
      const r = b.rotulo!;
      const croqui = 'ancora' in b && !!(b as any).ancora;
      const [cx, cy] = r.dentro ? centro(b.pts) : [r.x!, r.y!];
      const tam = r.tam ?? (r.dentro ? 27 : 30);
      const ls = linhas(r.texto);
      const y0 = r.dentro ? cy - ((ls.length - 1) * tam * 1.02) / 2 + tam * 0.34 : cy - (ls.length - 1) * tam * 1.02;
      const classe = r.dentro ? (croqui ? 'm-rot m-rot-dentro' : 'm-rot m-rot-dentro m-rot-dentro-outro')
        : 'tipo' in b && !('ancora' in b) ? 'm-rot m-rot-nota' : croqui ? 'm-rot' : 'm-rot m-rot-outro';
      const texto = (
        <text class={classe} x={cx} y={y0} text-anchor={r.dentro ? 'middle' : r.a ?? 'middle'} font-size={tam} transform={r.rot ? `rotate(${r.rot} ${cx} ${cy})` : undefined}>
          {ls.map((l, i) => <tspan x={cx} dy={i === 0 ? 0 : tam * 1.02}>{l}</tspan>)}
        </text>
      );
      return (
        <g>
          {r.ancora && <line x1={cx} y1={cy - tam * 0.3} x2={r.ancora[0]} y2={r.ancora[1]} class="m-guia" />}
          {croqui ? <a href={`#${(b as any).ancora}`}>{texto}</a> : texto}
        </g>
      );
    })}

    {m.textos.map((t) => {
      const ls = linhas(t.texto);
      const tam = t.estilo === 'setor' ? 22 : t.estilo === 'nota' ? 24 : 28;
      const texto = (
        <text class={`m-rot m-rot-${t.estilo ?? 'nota'}`} x={t.x} y={t.y} text-anchor={t.a ?? 'middle'} font-size={tam} transform={t.rot ? `rotate(${t.rot} ${t.x} ${t.y})` : undefined}>
          {ls.map((l, i) => <tspan x={t.x} dy={i === 0 ? 0 : tam * 1.02}>{l}</tspan>)}
        </text>
      );
      return (
        <g>
          {t.ancora && <line x1={t.x} y1={t.y! + 6} x2={t.ancora[0]} y2={t.ancora[1]} class="m-guia" />}
          {t.link ? <a href={`#${t.link}`}>{texto}</a> : texto}
        </g>
      );
    })}

    {m.saidas.map((s) => (
      <text class="m-rot m-rot-saida" x={s.x} y={s.y} text-anchor={s.a ?? 'start'} font-size="26">
        <tspan x={s.x}>{s.texto.toUpperCase()}</tspan>
        {s.sub && <tspan x={s.x} dy="26" class="m-rot-saida-sub" font-size="21">{s.sub}</tspan>}
      </text>
    ))}
  </g>
</svg>

<style is:global>
  .mapa-svg {
    --mapa-fundo: light-dark(#eef0e7, #18201b);
    --mapa-curva: light-dark(#e1e5d8, #212a24);
    --mapa-bloco: light-dark(#3d4a42, #b5c2b9);
    --mapa-bloco-borda: light-dark(#2a332d, #d8e2db);
    --mapa-outro: light-dark(#b7bdb3, #4b554e);
    --mapa-trilha: light-dark(#30352f, #dfe4dd);
    --mapa-interditada: light-dark(#b24a37, #e0806d);
    --mapa-clareira: light-dark(#e3dabd, #3a3628);
    --mapa-pedreira: light-dark(#d9d3c6, #34322c);
    --mapa-hachura: light-dark(#b1a993, #57534a);
    --mapa-saida: var(--destaque);
    display: block; width: 100%; height: auto; border-radius: 12px;
  }
  .mapa-svg .m-fundo { fill: var(--mapa-fundo); }
  .mapa-svg .m-curva { fill: none; stroke: var(--mapa-curva); stroke-width: 2.5; }
  .mapa-svg .m-clareira { fill: var(--mapa-clareira); stroke: var(--mapa-hachura); stroke-width: 2; stroke-dasharray: 6 6; }
  .mapa-svg .m-pedreira { fill: var(--mapa-pedreira); }
  .mapa-svg .m-hachura { stroke: var(--mapa-hachura); stroke-width: 3; }
  .mapa-svg .m-area-pedreira { stroke: var(--mapa-hachura); stroke-width: 2; }
  .mapa-svg .m-trilha-halo { fill: none; stroke: var(--mapa-fundo); stroke-width: 13; stroke-linecap: round; stroke-linejoin: round; }
  .mapa-svg .m-trilha { fill: none; stroke: var(--mapa-trilha); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 12 11; }
  .mapa-svg .m-interditada { stroke: var(--mapa-interditada); stroke-dasharray: 3 10; stroke-width: 5; }
  .mapa-svg .m-saida-haste { fill: none; stroke: var(--mapa-saida); stroke-width: 8; stroke-linecap: round; }
  .mapa-svg .m-saida-ponta { fill: var(--mapa-saida); stroke: var(--mapa-saida); stroke-width: 4; stroke-linejoin: round; }
  .mapa-svg .m-bloco { fill: var(--mapa-bloco); stroke: var(--mapa-bloco-borda); stroke-width: 2; }
  .mapa-svg .m-bloco.m-outro { fill: var(--mapa-outro); stroke: none; }
  .mapa-svg a:hover .m-bloco { fill: var(--mapa-saida); }
  .mapa-svg .m-guia { stroke: var(--mapa-trilha); stroke-width: 2; opacity: 0.55; }
  .mapa-svg .m-rot { font-family: 'Barlow Condensed', 'Arial Narrow', system-ui, sans-serif; font-weight: 700; fill: var(--tinta); stroke: var(--mapa-fundo); stroke-width: 7; stroke-linejoin: round; paint-order: stroke; }
  .mapa-svg .m-rot-outro { fill: var(--cinza); font-weight: 600; }
  .mapa-svg .m-rot-nota { font-family: 'Inter Variable', system-ui, sans-serif; font-weight: 500; font-style: italic; fill: var(--cinza); }
  .mapa-svg .m-rot-setor { font-family: 'Inter Variable', system-ui, sans-serif; font-weight: 700; letter-spacing: 0.12em; fill: var(--cinza); }
  .mapa-svg .m-rot-bloco { fill: var(--tinta); }
  .mapa-svg .m-rot-dentro { fill: var(--mapa-fundo); stroke: none; }
  .mapa-svg .m-rot-dentro-outro { fill: light-dark(#3d4a42, #e3e6e1); }
  .mapa-svg .m-rot-saida { fill: var(--mapa-saida); letter-spacing: 0.03em; }
  .mapa-svg .m-rot-saida-sub { font-family: 'Inter Variable', system-ui, sans-serif; font-weight: 500; letter-spacing: 0; fill: var(--cinza); }
  .mapa-svg a .m-rot { text-decoration: none; }
  @media print { .mapa-svg { color-scheme: light; } }
</style>
